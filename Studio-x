    local ks = garis(kotak, 1, T.off, 0)
    local centang = buat("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "✓",
        Font = Enum.Font.SourceSansBold,
        TextSize = 16,
        TextColor3 = Color3.new(1, 1, 1),
