local function ambilKarakter()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    return char, hum, hrp
end

local kecJalan, kuatLompat = nil, nil
local flyAktif, flyKec = false, 60
local noclipAktif, lompatTakTerbatas = false, false
local bv, bg

-- ---- Rig R6 / R15 ----
local rigLabel
local tombolR6, tombolR15

local function perbaruiRigUI()
    local _, hum = ambilKarakter()
    local r6 = hum and hum.RigType == Enum.HumanoidRigType.R6
    if tombolR6 and tombolR15 then
        tween(tombolR6, {BackgroundColor3 = r6 and palet[idxPalet][1] or T.panel2})
        tween(tombolR15, {BackgroundColor3 = (hum and not r6) and palet[idxPalet][1] or T.panel2})
    end
    if rigLabel then
        rigLabel.Text = "Rig saat ini: " .. (hum and (r6 and "R6" or "R15") or "-")
    end
end

local function gantiRig(tipe)
    local char, hum, hrp = ambilKarakter()
    if hum and hum.RigType == tipe then
        notif("Sudah memakai " .. (tipe == Enum.HumanoidRigType.R6 and "R6" or "R15"))
        return
    end
    notif("Mengganti rig...")
    task.spawn(function()
        local cf = hrp and hrp.CFrame or CFrame.new(0, 10, 0)
        local ok, err = pcall(function()
            local desc = Players:GetHumanoidDescriptionFromUserId(player.UserId)
            local model = Players:CreateHumanoidModelFromDescription(desc, tipe)
            model.Name = player.Name
            local lamaChar = player.Character
            player.Character = model
            model.Parent = Workspace
            model:PivotTo(cf + Vector3.new(0, 3, 0))
            if lamaChar then lamaChar:Destroy() end
            local hBaru = model:WaitForChild("Humanoid", 5)
            if hBaru then kamera.CameraSubject = hBaru end
        end)
        if ok then
            notif("Rig diganti ke " .. (tipe == Enum.HumanoidRigType.R6 and "R6" or "R15"))
        else
            notif("Gagal ganti rig")
            warn("[StudioPlus] Gagal ganti rig:", err)
        end
        task.wait(0.6)
        perbaruiRigUI()
    end)
end

-- ---- Fly ----
local function setFly(on)
    flyAktif = on
    local char, hum, hrp = ambilKarakter()
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    if on and hrp and hum then
        bv = buat("BodyVelocity", {MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero}, hrp)
        bg = buat("BodyGyro", {MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 1e4, CFrame = hrp.CFrame}, hrp)
        hum.PlatformStand = true
    elseif hum then
        hum.PlatformStand = false
    end
end

sambung(RunService.Heartbeat, function()
    local _, hum, hrp = ambilKarakter()
    if not hum then return end
    if kecJalan then hum.WalkSpeed = kecJalan end
    if kuatLompat then
        hum.UseJumpPower = true
        hum.JumpPower = kuatLompat
    end
    if flyAktif and bv and bg and bv.Parent and hrp then
        local md = hum.MoveDirection
        local cam = kamera.CFrame
        if md.Magnitude > 0.05 then
            local datar = Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z)
            local kanan = Vector3.new(cam.RightVector.X, 0, cam.RightVector.Z)
            local maju = datar.Magnitude > 0 and md:Dot(datar.Unit) or 0
            local geser = kanan.Magnitude > 0 and md:Dot(kanan.Unit) or 0
            bv.Velocity = (cam.LookVector * maju + cam.RightVector * geser) * flyKec
        else
            bv.Velocity = Vector3.zero
        end
        bg.CFrame = cam
    end
end)

-- ---- Noclip ----
sambung(RunService.Stepped, function()
    if noclipAktif then
        local char = player.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end
end)

