-- Palette gradient AKURAT
-- X = hue, Y = saturasi. Kegelapan lewat BackgroundColor3 (abu val)
-- yang dikali dengan UIGradient => hue*val dan putih*val = HSV asli
---------------------------------------------------------------------
local hueLayer, satLayer
local paletteZ = 1

if palette and palette:IsA("GuiObject") then
	paletteZ = palette.ZIndex
	palette.Active = true
	palette.BackgroundTransparency = 1
	palette.ClipsDescendants = true
	if palette:IsA("ImageButton") or palette:IsA("ImageLabel") then
		palette.ImageTransparency = 1
	end

	for _, n in ipairs({ "HueLayer", "SatLayer", "DarkLayer" }) do
		local old = palette:FindFirstChild(n)
		if old then old:Destroy() end
	end

	local function layer(name, z)
		local f = Instance.new("Frame")
		f.Name = name
		f.Position = UDim2.fromScale(0, 0)
		f.Size = UDim2.fromScale(1, 1)
		f.BorderSizePixel = 0
		f.Active = false
		f.ZIndex = paletteZ + z
		f.BackgroundTransparency = 0
		f.BackgroundColor3 = Color3.new(val, val, val)
		f.Parent = palette
		addCorner(f, 3)
		return f
	end

	-- 1) Pelangi horizontal
	hueLayer = layer("HueLayer", 1)
	local hg = Instance.new("UIGradient")
	local keys = {}
	for i = 0, 6 do
		keys[#keys + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i == 6 and 0 or i / 6, 1, 1))
	end
	hg.Color = ColorSequence.new(keys)
	hg.Rotation = 0
	hg.Parent = hueLayer

	-- 2) Putih: atas transparan (sat 1) -> bawah pekat (sat 0)
	satLayer = layer("SatLayer", 2)
	local sg = Instance.new("UIGradient")
	sg.Rotation = 90
	sg.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0),
	})
	sg.Parent = satLayer
end

