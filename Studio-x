        refreshList(historySw, history)
    end

    local function addFavorite(color)
        for _, f in ipairs(favorites) do
            if same(f, color) then return end
        end
        if #favorites >= MAX_FAV then table.remove(favorites, 1) end
        table.insert(favorites, color)
        refreshList(favSw, favorites)
    end

    ---------------------------------------------------------------------
    -- Undo / Redo
    ---------------------------------------------------------------------
    local function snapshot(throttle)
        local now = os.clock()
        if throttle and now - lastSnap < 0.5 then
            lastSnap = now
            return
        end
        lastSnap = now
        local top = undoStack[#undoStack]
        if not top or not same(top, currentColor) then
            table.insert(undoStack, currentColor)
            if #undoStack > 50 then table.remove(undoStack, 1) end
        end
        redoStack = {}
    end

    local function undo()
        if #undoStack == 0 then return end
        table.insert(redoStack, currentColor)
        setColor(table.remove(undoStack), true)
    end

    local function redo()
        if #redoStack == 0 then return end
        table.insert(undoStack, currentColor)
        setColor(table.remove(redoStack), true)
    end

    ---------------------------------------------------------------------
    -- Update visual
    ---------------------------------------------------------------------
    updateIndicators = function(animated)
        local info = animated and TWEEN_FAST or nil

        if palette and palette:IsA("GuiObject") and crosshair and crosshair:IsA("GuiObject") then
            local ax = palette.AbsolutePosition.X + hue * palette.AbsoluteSize.X
            local ay = palette.AbsolutePosition.Y + (1 - sat) * palette.AbsoluteSize.Y
            crosshair.AnchorPoint = Vector2.new(0.5, 0.5)
            setInParent(crosshair, ax, ay, info, "crosshairPos")
        end

        if darkMarker then
            local target = UDim2.new(0.5, 0, 1 - val, 0)
            if info then
                tween(darkMarker, info, { Position = target }, "darkMarkerPos")
            else
                darkMarker.Position = target
            end
        end
    end

    refreshExtras = function()
        local r, g, b = to255(currentColor)
        if not rBox:IsFocused() then rBox.Text = tostring(r) end
        if not gBox:IsFocused() then gBox.Text = tostring(g) end
        if not bBox:IsFocused() then bBox.Text = tostring(b) end
        if not hBox:IsFocused() then hBox.Text = tostring(math.round(hue * 360) % 360) end
        if not sBox:IsFocused() then sBox.Text = tostring(math.round(sat * 100)) end
        if not vBox:IsFocused() then vBox.Text = tostring(math.round(val * 100)) end
        if not hexBox:IsFocused() then hexBox.Text = "#" .. currentColor:ToHex():upper() end
        tween(hexStroke, TWEEN_MED, { Color = currentColor }, "hexStrokeColor")

        preview.BackgroundColor3 = currentColor
        local rw = contrast(currentColor, Color3.new(1, 1, 1))
        local rb = contrast(currentColor, Color3.new(0, 0, 0))
        local best = math.max(rw, rb)
        local grade = best >= 7 and "AAA" or best >= 4.5 and "AA" or best >= 3 and "AA Large" or "Fail"
        contrastInfo.TextColor3 = rw >= rb and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
        contrastInfo.Text = string.format("W %.1f  B %.1f  %s", rw, rb, grade)

        local name, exact = brickName(currentColor)
        nearestLabel.Text = (exact and "BrickColor: " or "Nearest BrickColor: ") .. name

        local mode = HARMONIES[harmonyIndex]
        harmonyBtn.Text = "Mode: " .. mode.name .. "  ›"
        for i, sw in ipairs(harmonySw) do
            if i == 1 then
                harmonyColors[i] = currentColor
            elseif mode.offsets[i - 1] then
                harmonyColors[i] = Color3.fromHSV((hue + mode.offsets[i - 1] / 360) % 1, sat, val)
            else
                harmonyColors[i] = nil
            end
            sw.Visible = harmonyColors[i] ~= nil
            if harmonyColors[i] then sw.BackgroundColor3 = harmonyColors[i] end
        end

        for i = 1, 7 do
            shadeColors[i] = Color3.fromHSV(hue, sat, 1 - (i - 1) / 6 * 0.9)
            shadeSw[i].BackgroundColor3 = shadeColors[i]
            tintColors[i] = Color3.fromHSV(hue, 1 - (i - 1) / 6, val)
            tintSw[i].BackgroundColor3 = tintColors[i]
        end
    end

    updateColor = function()
        currentColor = Color3.fromHSV(hue, sat, val)
        local r, g, b = to255(currentColor)

        if darkOverlay then
            darkOverlay.BackgroundTransparency = val
        end
        if darkGradient then
            darkGradient.Color = ColorSequence.new(Color3.fromHSV(hue, sat, 1), Color3.new(0, 0, 0))
        end

        if selectedColorFrame and selectedColorFrame:IsA("GuiObject") then
            tween(selectedColorFrame, TWEEN_MED, { BackgroundColor3 = currentColor }, "selBg")
            if selectedColorFrame:IsA("ImageLabel") or selectedColorFrame:IsA("ImageButton") then
                if selectedColorFrame.Image ~= "" then
                    tween(selectedColorFrame, TWEEN_MED, { ImageColor3 = currentColor }, "selImg")
                end
            end
            if selectedColorFrame:IsA("TextLabel") or selectedColorFrame:IsA("TextButton") then
                selectedColorFrame.TextColor3 = luminance(currentColor) > 0.4 and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
            end
        end

        if selectedColorText and (selectedColorText:IsA("TextLabel") or selectedColorText:IsA("TextButton")) then
            selectedColorText.Text = string.format("RGB: %d, %d, %d", r, g, b)
        end

        if selectedBrickText and (selectedBrickText:IsA("TextLabel") or selectedBrickText:IsA("TextButton")) then
            local name, exact = brickName(currentColor)
            selectedBrickText.Text = exact and name or "Custom"
        end

        refreshExtras()
        colorPalette:SetAttribute("SelectedColor", currentColor)
    end

    setColor = function(color, animated)
        if typeof(color) ~= "Color3" then return end
        hue, sat, val = color:ToHSV()
        updateColor()
        updateIndicators(animated)
    end

    changeColor = function(color, animated)
        snapshot()
        setColor(color, animated)
    end

    ---------------------------------------------------------------------
    -- Input palette / darkness
    ---------------------------------------------------------------------
    local function pulseCrosshair()
        if not crosshair or not crosshair:IsA("GuiObject") then return end
        local base = crosshair:GetAttribute("BaseSize")
        if not base then
            base = crosshair.Size
            crosshair:SetAttribute("BaseSize", base)
        end
        crosshair.Size = UDim2.new(base.X.Scale, base.X.Offset + 8, base.Y.Scale, base.Y.Offset + 8)
        tween(crosshair, TWEEN_POP, { Size = base }, "crosshairPulse")
    end

    local function handlePalette(pos)
        if not palette or not palette:IsA("GuiObject") then return end
        if palette.AbsoluteSize.X <= 0 or palette.AbsoluteSize.Y <= 0 then return end
        local rx = math.clamp((pos.X - palette.AbsolutePosition.X) / palette.AbsoluteSize.X, 0, 1)
        local ry = math.clamp((pos.Y - palette.AbsolutePosition.Y) / palette.AbsoluteSize.Y, 0, 1)
        hue = rx
        sat = 1 - ry
        updateColor()
        updateIndicators(true)
    end

    local function handleDarkness(pos)
        if not darkness or not darkness:IsA("GuiObject") then return end
        if darkness.AbsoluteSize.Y <= 0 then return end
        local ry = math.clamp((pos.Y - darkness.AbsolutePosition.Y) / darkness.AbsoluteSize.Y, 0, 1)
        val = 1 - ry
        updateColor()
        updateIndicators(true)
    end

    local function isPress(input)
        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
    end

    if palette and palette:IsA("GuiObject") then
        palette.InputBegan:Connect(function(input)
            if isPress(input) then
                snapshot()
                draggingPalette = true
                pulseCrosshair()
                handlePalette(input.Position)
            end
        end)
        palette.MouseEnter:Connect(function() hoverWheel += 1 end)
        palette.MouseLeave:Connect(function() hoverWheel = math.max(0, hoverWheel - 1) end)
    end

    if darkness and darkness:IsA("GuiObject") then
        darkness.InputBegan:Connect(function(input)
            if isPress(input) then
                snapshot()
                draggingDarkness = true
                handleDarkness(input.Position)
            end
        end)
        darkness.MouseEnter:Connect(function() hoverWheel += 1 end)
        darkness.MouseLeave:Connect(function() hoverWheel = math.max(0, hoverWheel - 1) end)
    end

    handle.InputBegan:Connect(function(input)
        if isPress(input) then
            draggingWindow = true
            dragStart = input.Position
            dragOrigin = colorPalette.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            if hoverWheel > 0 and colorPalette.Visible then
                snapshot(true)
                val = math.clamp(val + input.Position.Z * 0.03, 0, 1)
                updateColor()
                updateIndicators(true)
            end
        elseif input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            if draggingWindow and dragStart and dragOrigin then
                local d = input.Position - dragStart
                colorPalette.Position = UDim2.new(
                    dragOrigin.X.Scale, dragOrigin.X.Offset + d.X,
                    dragOrigin.Y.Scale, dragOrigin.Y.Offset + d.Y
                )
            elseif draggingPalette then
                handlePalette(input.Position)
            elseif draggingDarkness then
                handleDarkness(input.Position)
            end
        end
    end)

    ---------------------------------------------------------------------
    -- Klik di luar frame = tutup
    ---------------------------------------------------------------------
    local function insideGui(gui, pos)
        if not gui then return false end
        local p, s = gui.AbsolutePosition, gui.AbsoluteSize
        return pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
    end

    local cancel -- forward

    UserInputService.InputBegan:Connect(function(input)
        if not isPress(input) then return end
        if not colorPalette.Visible or closing then return end
        if os.clock() - openedAt < 0.3 then return end
        local pos = input.Position
        if insideGui(colorPalette, pos) or insideGui(extras, pos) then return end
        pressedOutside = true
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not isPress(input) then return end

        if draggingWindow then
            tween(grip, TWEEN_FAST, { Size = UDim2.fromOffset(40, 4), BackgroundColor3 = THEME.textDim, BackgroundTransparency = 0.3 }, "gripHover")
        end
        draggingPalette = false
        draggingDarkness = false
        draggingWindow = false

        if pressedOutside then
            pressedOutside = false
            task.delay(0.1, function()
                if colorPalette.Visible and not closing and cancel then
                    cancel(true)
                end
            end)
        end
    end)

    ---------------------------------------------------------------------
    -- BasicColors
    ---------------------------------------------------------------------
    local function bindBasicButton(btn)
        if not btn:IsA("GuiButton") then return end
        local baseSize = btn.Size
        local baseTransparency = btn.BackgroundTransparency

        studioBox(btn, THEME.border)
        local st = btn:FindFirstChildOfClass("UIStroke")

        btn.MouseEnter:Connect(function()
            tween(btn, TWEEN_FAST, {
                Size = UDim2.new(baseSize.X.Scale, baseSize.X.Offset + 4, baseSize.Y.Scale, baseSize.Y.Offset + 4),
            }, btn)
            if st then tween(st, TWEEN_FAST, { Color = THEME.accent }, st) end
        end)
        btn.MouseLeave:Connect(function()
            tween(btn, TWEEN_FAST, { Size = baseSize }, btn)
            if st then tween(st, TWEEN_FAST, { Color = THEME.border }, st) end
        end)
        btn.MouseButton1Click:Connect(function()
            changeColor(btn.BackgroundColor3, true)
            pulseCrosshair()
            btn.BackgroundTransparency = 0.5
            tween(btn, TWEEN_MED, { BackgroundTransparency = baseTransparency }, btn.Name .. "_flash")
        end)
    end

    if basicColors then
        for _, child in ipairs(basicColors:GetChildren()) do
            bindBasicButton(child)
        end
        basicColors.ChildAdded:Connect(bindBasicButton)
    end

    ---------------------------------------------------------------------
    -- Input extras
    ---------------------------------------------------------------------
    local function shake(gui)
        local base = gui.Position
        for _, off in ipairs({ 6, -6, 4, -4, 0 }) do
            gui.Position = UDim2.new(base.X.Scale, base.X.Offset + off, base.Y.Scale, base.Y.Offset)
            task.wait(0.03)
        end
    end

    hexBox.FocusLost:Connect(function()
        local c = parseHex(hexBox.Text)
        if c then
            changeColor(c, true)
            pulseCrosshair()
        else
            task.spawn(shake, hexBox)
            refreshExtras()
        end
    end)

    local function commitRGB()
        local r, g, b = tonumber(rBox.Text), tonumber(gBox.Text), tonumber(bBox.Text)
        if r and g and b then
            changeColor(Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255)), true)
            pulseCrosshair()
        else
            refreshExtras()
        end
    end
    for _, bx in ipairs({ rBox, gBox, bBox }) do bx.FocusLost:Connect(commitRGB) end

    local function commitHSV()
        local h, s, v = tonumber(hBox.Text), tonumber(sBox.Text), tonumber(vBox.Text)
        if h and s and v then
            snapshot()
            hue = (h % 360) / 360
            sat = math.clamp(s, 0, 100) / 100
            val = math.clamp(v, 0, 100) / 100
            updateColor()
            updateIndicators(true)
            pulseCrosshair()
        else
            refreshExtras()
        end
    end
    for _, bx in ipairs({ hBox, sBox, vBox }) do bx.FocusLost:Connect(commitHSV) end

    local function randomColor()
        snapshot()
        hue, sat, val = math.random(), 0.4 + math.random() * 0.6, 0.5 + math.random() * 0.5
        updateColor()
        updateIndicators(true)
        pulseCrosshair()
    end
    randomBtn.MouseButton1Click:Connect(randomColor)

    ---------------------------------------------------------------------
    -- Quick actions, harmony, swatches
    ---------------------------------------------------------------------
    ops1[1].MouseButton1Click:Connect(function()
        changeColor(Color3.new(1 - currentColor.R, 1 - currentColor.G, 1 - currentColor.B), true)
    end)
    ops1[2].MouseButton1Click:Connect(function()
        local l = currentColor.R * 0.299 + currentColor.G * 0.587 + currentColor.B * 0.114
        changeColor(Color3.new(l, l, l), true)
    end)
    ops1[3].MouseButton1Click:Connect(function()
        snapshot()
        val = math.clamp(val + 0.1, 0, 1)
        updateColor(); updateIndicators(true)
    end)
    ops1[4].MouseButton1Click:Connect(function()
        snapshot()
        val = math.clamp(val - 0.1, 0, 1)
        updateColor(); updateIndicators(true)
    end)

    ops2[1].MouseButton1Click:Connect(undo)
    ops2[2].MouseButton1Click:Connect(redo)
    ops2[3].MouseButton1Click:Connect(function()
        changeColor(openColor, true)
    end)
    ops2[4].MouseButton1Click:Connect(function()
        addFavorite(currentColor)
    end)

    harmonyBtn.MouseButton1Click:Connect(function()
        harmonyIndex = harmonyIndex % #HARMONIES + 1
        refreshExtras()
    end)

    for i, sw in ipairs(harmonySw) do
        sw.MouseButton1Click:Connect(function()
            if harmonyColors[i] and i > 1 then changeColor(harmonyColors[i], true) end
        end)
    end
    for i, sw in ipairs(shadeSw) do
        sw.MouseButton1Click:Connect(function()
            if shadeColors[i] then changeColor(shadeColors[i], true) end
        end)
    end
    for i, sw in ipairs(tintSw) do
        sw.MouseButton1Click:Connect(function()
            if tintColors[i] then changeColor(tintColors[i], true) end
        end)
    end
    for i, sw in ipairs(historySw) do
        sw.MouseButton1Click:Connect(function()
            if history[i] then changeColor(history[i], true) end
        end)
    end
    for i, sw in ipairs(favSw) do
        sw.MouseButton1Click:Connect(function()
            if favorites[i] then changeColor(favorites[i], true) end
        end)
        local function remove()
            if favorites[i] then
                table.remove(favorites, i)
                refreshList(favSw, favorites)
            end
        end
        sw.MouseButton2Click:Connect(remove)
        sw.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                local held = true
                local conn
                conn = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        held = false
                        if conn then conn:Disconnect() end
                    end
                end)
                task.delay(0.6, function()
                    if held then
                        if conn then conn:Disconnect() end
                        remove()
                    end
                end)
            end
        end)
    end
    clearFavBtn.MouseButton1Click:Connect(function()
        favorites = {}
        refreshList(favSw, favorites)
    end)

    ---------------------------------------------------------------------
    -- Close + Confirm + Cancel
    ---------------------------------------------------------------------
    local function closePicker()
        if closing then return end
        closing = true
        tween(colorPalette, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(originalSize.X.Scale * 0.8, originalSize.X.Offset * 0.8,
                originalSize.Y.Scale * 0.8, originalSize.Y.Offset * 0.8),
        }, "closeTween")
        task.wait(0.2)
        colorPalette.Visible = false
        colorPalette.Size = originalSize
        closing = false
    end

    local baseTextSize = (okButton and okButton:IsA("TextButton")) and okButton.TextSize or nil

    local function confirm()
        if closing then return end
        local r, g, b = to255(currentColor)
        local name = brickName(currentColor)
        print(string.format("[ColorPalette] Warna dipilih: %d, %d, %d (%s) #%s",
            r, g, b, name, currentColor:ToHex():upper()))
        colorPalette:SetAttribute("SelectedColor", currentColor)
        colorPalette:SetAttribute("SelectedHex", "#" .. currentColor:ToHex():upper())
        colorPalette:SetAttribute("Confirmed", (colorPalette:GetAttribute("Confirmed") or 0) + 1)
        pushHistory(currentColor)
        if baseTextSize and okButton then
            okButton.TextSize = baseTextSize + 6
            tween(okButton, TWEEN_POP, { TextSize = baseTextSize }, "okText")
        end
        task.spawn(closePicker)
    end

    cancel = function()
        if closing then return end
        setColor(openColor, false)
        colorPalette:SetAttribute("Cancelled", (colorPalette:GetAttribute("Cancelled") or 0) + 1)
        task.spawn(closePicker)
    end

    if okButton and okButton:IsA("GuiButton") then
        okButton.MouseButton1Click:Connect(confirm)
    end
    if cancelButton and cancelButton:IsA("GuiButton") then
        cancelButton.MouseButton1Click:Connect(function() cancel(false) end)
    end

    ---------------------------------------------------------------------
    -- Shortcut keyboard
    ---------------------------------------------------------------------
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe or not colorPalette.Visible or closing then return end
        local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
        local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
        local step = shift and 0.05 or 0.01
        local k = input.KeyCode

        if ctrl and k == Enum.KeyCode.Z then
            if shift then redo() else undo() end
            return
        elseif ctrl and k == Enum.KeyCode.Y then
            redo()
            return
        end

        if k == Enum.KeyCode.Return or k == Enum.KeyCode.KeypadEnter then
            confirm()
        elseif k == Enum.KeyCode.Escape then
            cancel(false)
        elseif k == Enum.KeyCode.R then
            randomColor()
        elseif k == Enum.KeyCode.F then
            addFavorite(currentColor)
        elseif k == Enum.KeyCode.I then
            changeColor(Color3.new(1 - currentColor.R, 1 - currentColor.G, 1 - currentColor.B), true)
        elseif k == Enum.KeyCode.Left then
            snapshot(true); hue = (hue - step) % 1
            updateColor(); updateIndicators(true)
        elseif k == Enum.KeyCode.Right then
            snapshot(true); hue = (hue + step) % 1
            updateColor(); updateIndicators(true)
        elseif k == Enum.KeyCode.Up then
            snapshot(true); sat = math.clamp(sat + step, 0, 1)
            updateColor(); updateIndicators(true)
        elseif k == Enum.KeyCode.Down then
            snapshot(true); sat = math.clamp(sat - step, 0, 1)
            updateColor(); updateIndicators(true)
        elseif k == Enum.KeyCode.PageUp then
            snapshot(true); val = math.clamp(val + step, 0, 1)
            updateColor(); updateIndicators(true)
        elseif k == Enum.KeyCode.PageDown then
            snapshot(true); val = math.clamp(val - step, 0, 1)
            updateColor(); updateIndicators(true)
        end
    end)

    ---------------------------------------------------------------------
    -- Animasi saat dibuka
    ---------------------------------------------------------------------
    colorPalette:GetPropertyChangedSignal("Visible"):Connect(function()
        if not colorPalette.Visible then
            pressedOutside = false
            return
        end

        openedAt = os.clock()
        pressedOutside = false

        if not closing then
            openColor = currentColor
            undoStack, redoStack = {}, {}
            colorPalette.Size = UDim2.new(originalSize.X.Scale * 0.85, originalSize.X.Offset * 0.85,
                originalSize.Y.Scale * 0.85, originalSize.Y.Offset * 0.85)
            tween(colorPalette, TWEEN_POP, { Size = originalSize }, "openTween")
            task.delay(0.35, function()
                updateIndicators(false)
            end)
            task.defer(function()
                updateIndicators(false)
            end)
        end
    end)

    if palette and palette:IsA("GuiObject") then
        palette:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            updateIndicators(false)
        end)
        palette:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
            if not draggingPalette then updateIndicators(false) end
        end)
    end

    colorPalette:GetAttributeChangedSignal("SelectedColor"):Connect(function()
        local c = colorPalette:GetAttribute("SelectedColor")
        if typeof(c) == "Color3" and not same(c, currentColor) then
            setColor(c, false)
        end
    end)

    ---------------------------------------------------------------------
    -- Inisialisasi
    ---------------------------------------------------------------------
    task.wait()
    local startColor = colorPalette:GetAttribute("SelectedColor")
    if typeof(startColor) ~= "Color3" then
        if selectedColorFrame and selectedColorFrame:IsA("GuiObject") then
            startColor = selectedColorFrame.BackgroundColor3
        else
            startColor = Color3.fromRGB(163, 162, 165)
        end
    end
    setColor(startColor, false)
    openColor = currentColor
    refreshList(historySw, history)
    refreshList(favSw, favorites)
end)
