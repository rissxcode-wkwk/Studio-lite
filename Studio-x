        TextColor3 = T.text,
    }, baris)
    -- kotak centang ala Studio
    local kotak = buat("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(1, -28, 0.5, -9),
        BackgroundColor3 = T.bg,
