	sw.MouseButton1Click:Connect(function()
		if history[i] then
			setColor(history[i], true)
		end
	end)
end

local function pushHistory(color)
	for i = #history, 1, -1 do
		if same(history[i], color) then
			table.remove(history, i)
		end
	end
	table.insert(history, 1, color)
	while #history > MAX_HISTORY do
		table.remove(history)
	end
	refreshHistory()
end

---------------------------------------------------------------------
-- Update visual
---------------------------------------------------------------------
local function updateIndicators(animated)
	local info = animated and TWEEN_FAST or nil

	if palette and palette:IsA("GuiObject") and crosshair then
		local ax = palette.AbsolutePosition.X + hue * palette.AbsoluteSize.X
		local ay = palette.AbsolutePosition.Y + (1 - sat) * palette.AbsoluteSize.Y
		crosshair.AnchorPoint = Vector2.new(0.5, 0.5)
		setInParent(crosshair, ax, ay, info, "crosshairPos")
	end

	if darkness and darkness:IsA("GuiObject") and darknessAppearance
		and darknessAppearance:IsA("GuiObject")
		and darknessAppearance.AbsoluteSize.Y < darkness.AbsoluteSize.Y * 0.5 then
		local ay = darkness.AbsolutePosition.Y + (1 - val) * darkness.AbsoluteSize.Y
		local parent = darknessAppearance.Parent
		local py = 0
		if parent and parent:IsA("GuiObject") then
			py = parent.AbsolutePosition.Y
		end
		darknessAppearance.AnchorPoint = Vector2.new(darknessAppearance.AnchorPoint.X, 0.5)
		local target = UDim2.new(
			darknessAppearance.Position.X.Scale,
			darknessAppearance.Position.X.Offset,
			0,
			ay - py
		)
		if info then
			tween(darknessAppearance, info, { Position = target }, "darkPos")
		else
			darknessAppearance.Position = target
		end
	end
end

local function updateColor()
	currentColor = Color3.fromHSV(hue, sat, val)
	local r, g, b = to255(currentColor)

	-- Palette tengah ikut gelap: val 1 = terang (transparan), val 0 = hitam
	if darkOverlay then
		tween(darkOverlay, TWEEN_FAST, { BackgroundTransparency = val }, "darkOverlay")
	end
	-- Bar darkness mengikuti hue & sat
	if darkGradient then
		darkGradient.Color = ColorSequence.new(Color3.fromHSV(hue, sat, 1), Color3.new(0, 0, 0))
	end

	if selectedColorFrame and selectedColorFrame:IsA("GuiObject") then
		tween(selectedColorFrame, TWEEN_MED, { BackgroundColor3 = currentColor }, "selBg")
		if selectedColorFrame:IsA("ImageLabel") or selectedColorFrame:IsA("ImageButton") then
			if selectedColorFrame.Image ~= "" then
				tween(selectedColorFrame, TWEEN_MED, { ImageColor3 = currentColor }, "selImg")
			end
		end
	end

	if selectedColorText and (selectedColorText:IsA("TextLabel") or selectedColorText:IsA("TextButton")) then
		selectedColorText.Text = string.format("RGB: %d, %d, %d", r, g, b)
	end

	if selectedBrickText and (selectedBrickText:IsA("TextLabel") or selectedBrickText:IsA("TextButton")) then
		selectedBrickText.Text = brickName(currentColor)
	end

	if not hexBox:IsFocused() then
		hexBox.Text = "#" .. currentColor:ToHex():upper()
	end

	colorPalette:SetAttribute("SelectedColor", currentColor)
end

setColor = function(color, animated)
	hue, sat, val = color:ToHSV()
	updateColor()
	updateIndicators(animated)
end

---------------------------------------------------------------------
-- Palette (klik + drag)
---------------------------------------------------------------------
local function pulseCrosshair()
	if not crosshair or not crosshair:IsA("GuiObject") then return end
	local base = crosshair:GetAttribute("BaseSize")
	if not base then
		base = crosshair.Size
		crosshair:SetAttribute("BaseSize", base)
	end
	crosshair.Size = UDim2.new(base.X.Scale, base.X.Offset + 8, base.Y.Scale, base.Y.Offset + 8)
	tween(crosshair, TWEEN_POP, { Size = base }, "crosshairPulse")
end

local function handlePalette(pos)
	if not palette or not palette:IsA("GuiObject") then return end
	local rx = math.clamp((pos.X - palette.AbsolutePosition.X) / palette.AbsoluteSize.X, 0, 1)
	local ry = math.clamp((pos.Y - palette.AbsolutePosition.Y) / palette.AbsoluteSize.Y, 0, 1)
	hue = rx
	sat = 1 - ry
	updateColor()
	updateIndicators(true)
end

local function handleDarkness(pos)
	if not darkness or not darkness:IsA("GuiObject") then return end
	local ry = math.clamp((pos.Y - darkness.AbsolutePosition.Y) / darkness.AbsoluteSize.Y, 0, 1)
	val = 1 - ry
	updateColor()
	updateIndicators(true)
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

if palette and palette:IsA("GuiButton") then
	palette.InputBegan:Connect(function(input)
		if isPress(input) then
			draggingPalette = true
			pulseCrosshair()
			handlePalette(input.Position)
		end
	end)
end

local function bindDarkness(gui)
	if gui and gui:IsA("GuiObject") then
		gui.InputBegan:Connect(function(input)
			if isPress(input) then
				draggingDarkness = true
				handleDarkness(input.Position)
			end
		end)
	end
end
bindDarkness(darkness)
if darknessAppearance ~= darkness then
	bindDarkness(darknessAppearance)
end

handle.InputBegan:Connect(function(input)
	if isPress(input) then
		draggingWindow = true
		dragStart = input.Position
		dragOrigin = colorPalette.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		if draggingWindow and dragStart then
			local d = input.Position - dragStart
			colorPalette.Position = UDim2.new(
				dragOrigin.X.Scale, dragOrigin.X.Offset + d.X,
				dragOrigin.Y.Scale, dragOrigin.Y.Offset + d.Y
			)
		elseif draggingPalette then
			handlePalette(input.Position)
		elseif draggingDarkness then
			handleDarkness(input.Position)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if isPress(input) then
		if draggingWindow then
			tween(grip, TWEEN_FAST, { Size = UDim2.fromOffset(40, 4), BackgroundTransparency = 0.2 }, "gripHover")
		end
		draggingPalette = false
		draggingDarkness = false
		draggingWindow = false
	end
end)

