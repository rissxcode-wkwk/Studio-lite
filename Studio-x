hexBox.FocusLost:Connect(function()
	tween(hexStroke, TWEEN_FAST, { Thickness = 1.5, Color = CLASSIC_DARK }, "hexFocus")
	local txt = hexBox.Text:gsub("[^%x]", "")
	if #txt == 3 then
		txt = txt:sub(1, 1):rep(2) .. txt:sub(2, 2):rep(2) .. txt:sub(3, 3):rep(2)
	end
	if #txt == 6 then
		local ok, c = pcall(Color3.fromHex, "#" .. txt)
		if ok and c then
			setColor(c, true)
			pulseCrosshair()
			return
		end
	end
	local base = hexBox.Position
	for _, off in ipairs({ 6, -6, 4, -4, 0 }) do
		hexBox.Position = UDim2.new(base.X.Scale, base.X.Offset + off, base.Y.Scale, base.Y.Offset)
		task.wait(0.03)
	end
	hexBox.Text = "#" .. currentColor:ToHex():upper()
end)

