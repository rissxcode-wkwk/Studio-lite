local function bindBasicButton(btn)
	if not btn:IsA("GuiButton") then return end
	local baseSize = btn.Size
	local baseTransparency = btn.BackgroundTransparency

	classicBox(btn)

	btn.MouseEnter:Connect(function()
		tween(btn, TWEEN_FAST, {
			Size = UDim2.new(baseSize.X.Scale, baseSize.X.Offset + 4, baseSize.Y.Scale, baseSize.Y.Offset + 4),
		}, btn)
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, TWEEN_FAST, { Size = baseSize }, btn)
	end)
	btn.MouseButton1Click:Connect(function()
		setColor(btn.BackgroundColor3, true)
		pulseCrosshair()
		btn.BackgroundTransparency = 0.5
		tween(btn, TWEEN_MED, { BackgroundTransparency = baseTransparency }, btn.Name .. "_flash")
	end)
end

