    local function to255(c)
        return math.clamp(math.round(c.R * 255), 0, 255),
            math.clamp(math.round(c.G * 255), 0, 255),
            math.clamp(math.round(c.B * 255), 0, 255)
    end

    local function same(a, b)
        if not a or not b then return false end
        local r1, g1, b1 = to255(a)
        local r2, g2, b2 = to255(b)
        return r1 == r2 and g1 == g2 and b1 == b2
    end

    local function setInParent(gui, absX, absY, tweenInfo, extraKey)
        if not gui or not gui:IsA("GuiObject") then return end
        local parent = gui.Parent
        local px, py = 0, 0
        if parent and parent:IsA("GuiObject") then
            px, py = parent.AbsolutePosition.X, parent.AbsolutePosition.Y
        end
        local target = UDim2.fromOffset(absX - px, absY - py)
        if tweenInfo then
            tween(gui, tweenInfo, { Position = target }, extraKey)
        else
            gui.Position = target
        end
    end

    local function brickName(color)
        local bc = BrickColor.new(color)
        if same(color, bc.Color) then
            return bc.Name, true
        end
        return bc.Name, false
    end

    local function addCorner(gui, radius)
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, radius)
        c.Parent = gui
        return c
    end

    local function addStroke(gui, color, thickness, transparency)
        local s = Instance.new("UIStroke")
        s.Color = color
        s.Thickness = thickness
        s.Transparency = transparency or 0
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent = gui
        return s
    end

    local function lin(c)
        return c <= 0.03928 and c / 12.92 or ((c + 0.055) / 1.055) ^ 2.4
    end
    local function luminance(c)
        return 0.2126 * lin(c.R) + 0.7152 * lin(c.G) + 0.0722 * lin(c.B)
    end
    local function contrast(a, b)
        local l1, l2 = luminance(a), luminance(b)
        if l1 < l2 then l1, l2 = l2, l1 end
        return (l1 + 0.05) / (l2 + 0.05)
    end

    local function parseHex(txt)
        txt = (txt or ""):gsub("[^%x]", "")
        if #txt == 3 then
            txt = txt:sub(1, 1):rep(2) .. txt:sub(2, 2):rep(2) .. txt:sub(3, 3):rep(2)
        end
        if #txt == 6 then
            local ok, c = pcall(Color3.fromHex, "#" .. txt)
            if ok then return c end
        end
        return nil
    end

