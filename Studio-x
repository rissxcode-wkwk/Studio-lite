local TWEEN_FAST = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_MED = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_POP = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local activeTweens = {}
local function tween(obj, info, props, key)
	if not obj then return end
	key = key or obj
	local old = activeTweens[key]
	if old then old:Cancel() end
	local ok, t = pcall(TweenService.Create, TweenService, obj, info, props)
	if ok and t then
		activeTweens[key] = t
		t:Play()
		return t
	end
end

---------------------------------------------------------------------
-- Helper
---------------------------------------------------------------------
local function to255(c)
	return math.clamp(math.round(c.R * 255), 0, 255),
		math.clamp(math.round(c.G * 255), 0, 255),
		math.clamp(math.round(c.B * 255), 0, 255)
end

local function setInParent(gui, absX, absY, tweenInfo, extraKey)
	if not gui or not gui:IsA("GuiObject") then return end
	local parent = gui.Parent
	local px, py = 0, 0
	if parent and parent:IsA("GuiObject") then
		px, py = parent.AbsolutePosition.X, parent.AbsolutePosition.Y
	end
	local target = UDim2.fromOffset(absX - px, absY - py)
	if tweenInfo then
		tween(gui, tweenInfo, { Position = target }, extraKey)
	else
		gui.Position = target
	end
end

local function brickName(color)
	local r, g, b = to255(color)
	local bc = BrickColor.new(color)
	local br, bg, bb = to255(bc.Color)
	if r == br and g == bg and b == bb then
		return bc.Name
	end
	return "Custom"
end

local function addCorner(gui, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = gui
	return c
end

local function addStroke(gui, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = gui
	return s
end

local function same(a, b)
	local r1, g1, b1 = to255(a)
	local r2, g2, b2 = to255(b)
	return r1 == r2 and g1 == g2 and b1 == b2
end

