    buat("TextLabel", {
        Size = UDim2.new(0.42, 0, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = teks,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = FONT,
        TextSize = 16,
        TextColor3 = T.text,
    }, baris)
    local nilai = awal
    local lbl = buat("TextLabel", {
        Size = UDim2.new(0, 44, 1, 0),
        Position = UDim2.new(1, -112, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(nilai),
        Font = Enum.Font.SourceSansBold,
        TextSize = 16,
        TextColor3 = palet[idxPalet][1],
    }, baris)
    table.insert(aksenObj, {lbl, "TextColor3"})
    local function kecil(t, x)
        local b = buat("TextButton", {
            Size = UDim2.new(0, 26, 0, 24),
            Position = UDim2.new(1, x, 0.5, -12),
            BackgroundColor3 = T.panel2,
            Text = t,
            Font = Enum.Font.SourceSansBold,
            TextSize = 18,
            TextColor3 = T.text,
        }, baris)
        sudut(b, 4)
        garis(b, 1, T.border, 0)
        return b
    end
    local kurang = kecil("−", -140)
    local tambah = kecil("+", -34)
    kurang.Position = UDim2.new(1, -140, 0.5, -12)
    local function ubah(d)
        nilai = math.clamp(nilai + d, min, maks)
        lbl.Text = tostring(nilai)
        pcall(fn, nilai)
    end
    sambung(kurang.MouseButton1Click, function() ubah(-langkah) end)
    sambung(tambah.MouseButton1Click, function() ubah(langkah) end)
    return function() return nilai end
end

