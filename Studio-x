        tween(kotak, {BackgroundColor3 = v and palet[idxPalet][1] or T.bg})
        tween(centang, {TextTransparency = v and 0 or 1})
        ks.Color = v and palet[idxPalet][1] or T.off
        if not diam then pcall(fn, v) end
    end
    sambung(baris.MouseButton1Click, function() set(not nilai) end)
    if awal then set(true) end
    return set
end

local function stepper(teks, min, maks, langkah, awal, fn)
    local baris = buat("Frame", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = T.panel,
        LayoutOrder = nomor(),
    }, body)
    sudut(baris, 4)
