---------------------------------------------------------------------
-- Close + Confirm + Cancel
---------------------------------------------------------------------
local function closePicker()
	if closing then return end
	closing = true
	local t = tween(colorPalette, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
		Size = UDim2.new(originalSize.X.Scale * 0.8, originalSize.X.Offset * 0.8,
			originalSize.Y.Scale * 0.8, originalSize.Y.Offset * 0.8),
	}, "closeTween")
	if t then t.Completed:Wait() end
	colorPalette.Visible = false
	colorPalette.Size = originalSize
	closing = false
end

local baseTextSize = (okButton and okButton:IsA("TextButton")) and okButton.TextSize or nil

local function confirm()
	local r, g, b = to255(currentColor)
	print(string.format("[ColorPalette] Warna dipilih: %d, %d, %d (%s) #%s",
		r, g, b, brickName(currentColor), currentColor:ToHex():upper()))
	colorPalette:SetAttribute("SelectedColor", currentColor)
	colorPalette:SetAttribute("SelectedHex", "#" .. currentColor:ToHex():upper())
	colorPalette:SetAttribute("Confirmed", (colorPalette:GetAttribute("Confirmed") or 0) + 1)
	pushHistory(currentColor)
	if baseTextSize then
		okButton.TextSize = baseTextSize + 6
		tween(okButton, TWEEN_POP, { TextSize = baseTextSize }, "okText")
	end
	task.spawn(closePicker)
end

local function cancel()
	setColor(openColor, false)
	task.spawn(closePicker)
end

if okButton and okButton:IsA("GuiButton") then
	okButton.MouseEnter:Connect(function()
		tween(okButton, TWEEN_FAST, { BackgroundTransparency = 0.15 }, "okHover")
	end)
	okButton.MouseLeave:Connect(function()
		tween(okButton, TWEEN_FAST, { BackgroundTransparency = 0 }, "okHover")
	end)
	okButton.MouseButton1Click:Connect(confirm)
end

if cancelButton and cancelButton:IsA("GuiButton") then
	cancelButton.MouseEnter:Connect(function()
		tween(cancelButton, TWEEN_FAST, { BackgroundTransparency = 0.15 }, "cancelHover")
	end)
	cancelButton.MouseLeave:Connect(function()
		tween(cancelButton, TWEEN_FAST, { BackgroundTransparency = 0 }, "cancelHover")
	end)
	cancelButton.MouseButton1Click:Connect(cancel)
end

---------------------------------------------------------------------
-- Shortcut keyboard
-- Enter = OK | Esc = batal | R = random
-- Panah = hue/saturasi | PageUp/PageDown = terang/gelap | Shift = cepat
---------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe or not colorPalette.Visible or closing then return end
	local step = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 0.05 or 0.01
	local k = input.KeyCode
	if k == Enum.KeyCode.Return or k == Enum.KeyCode.KeypadEnter then
		confirm()
	elseif k == Enum.KeyCode.Escape then
		cancel()
	elseif k == Enum.KeyCode.R then
		randomColor()
	elseif k == Enum.KeyCode.Left then
		hue = (hue - step) % 1
		updateColor(); updateIndicators(true)
	elseif k == Enum.KeyCode.Right then
		hue = (hue + step) % 1
		updateColor(); updateIndicators(true)
	elseif k == Enum.KeyCode.Up then
		sat = math.clamp(sat + step, 0, 1)
		updateColor(); updateIndicators(true)
	elseif k == Enum.KeyCode.Down then
		sat = math.clamp(sat - step, 0, 1)
		updateColor(); updateIndicators(true)
	elseif k == Enum.KeyCode.PageUp then
		val = math.clamp(val + step, 0, 1)
		updateColor(); updateIndicators(true)
	elseif k == Enum.KeyCode.PageDown then
		val = math.clamp(val - step, 0, 1)
		updateColor(); updateIndicators(true)
	end
end)

---------------------------------------------------------------------
-- Animasi saat dibuka & update layout
---------------------------------------------------------------------
colorPalette:GetPropertyChangedSignal("Visible"):Connect(function()
	if colorPalette.Visible and not closing then
		openColor = currentColor
		colorPalette.Size = UDim2.new(originalSize.X.Scale * 0.85, originalSize.X.Offset * 0.85,
			originalSize.Y.Scale * 0.85, originalSize.Y.Offset * 0.85)
		tween(colorPalette, TWEEN_POP, { Size = originalSize }, "openTween")
		task.defer(function()
			updateIndicators(false)
		end)
	end
end)

if palette and palette:IsA("GuiObject") then
	palette:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		updateIndicators(false)
	end)
	palette:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
		if not draggingPalette then updateIndicators(false) end
	end)
end

