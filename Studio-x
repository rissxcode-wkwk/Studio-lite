local function gayaTombol(b)
    if not (b:IsA("TextButton") or b:IsA("ImageButton")) then return end
    pcall(function()
        b.BackgroundColor3 = T.panel2
        b.BackgroundTransparency = 0
        if b:IsA("TextButton") then
            b.TextColor3 = T.text
            b.Font = FONT_B
        end
        local c = b:FindFirstChildOfClass("UICorner")
        if not c then c = Instance.new("UICorner") c.Parent = b end
        c.CornerRadius = UDim.new(0, 4)
        local s = garis(b, 1, T.border, 0)
        local asli
        sambung(b.MouseEnter, function()
            asli = b.BackgroundColor3
            tween(b, {BackgroundColor3 = T.hover})
            s.Color = palet[idxPalet][1]
        end)
        sambung(b.MouseLeave, function()
            tween(b, {BackgroundColor3 = asli or T.panel2})
            s.Color = T.border
        end)
        sambung(b.MouseButton1Down, function()
            tween(b, {BackgroundColor3 = palet[idxPalet][1]}, 0.06)
        end)
        sambung(b.MouseButton1Up, function()
            tween(b, {BackgroundColor3 = T.hover}, 0.15)
        end)
    end)
end

local function gayaMainBar()
    if not mainBar then return end
    pcall(function()
        mainBar.BackgroundColor3 = T.bg
        mainBar.BackgroundTransparency = 0
        local c = mainBar:FindFirstChildOfClass("UICorner")
        if not c then c = Instance.new("UICorner") c.Parent = mainBar end
        c.CornerRadius = UDim.new(0, 6)
        local s = garis(mainBar, 2, palet[idxPalet][1], 0)
        table.insert(aksenObj, {s, "Color"})
    end)

    for _, anak in ipairs(mainBar:GetChildren()) do
        if anak:IsA("TextButton") or anak:IsA("ImageButton") then
            gayaTombol(anak)
        elseif anak.Name == "sel" then
            for _, t in ipairs(anak:GetChildren()) do
                gayaTombol(t)
            end
        elseif anak.Name == "Snap" then
            pcall(function()
                anak.BackgroundColor3 = T.panel
                anak.BackgroundTransparency = 0
                local c = anak:FindFirstChildOfClass("UICorner") or buat("UICorner", {}, anak)
                c.CornerRadius = UDim.new(0, 4)
                garis(anak, 1, T.border, 0)
                for _, x in ipairs(anak:GetChildren()) do
                    if x:IsA("TextBox") then
                        x.BackgroundColor3 = T.bg
                        x.TextColor3 = T.text
                        x.PlaceholderColor3 = T.muted
                        x.Font = FONT
                        local cc = x:FindFirstChildOfClass("UICorner") or buat("UICorner", {}, x)
                        cc.CornerRadius = UDim.new(0, 3)
                        local ss = garis(x, 1, palet[idxPalet][1], 0)
                        table.insert(aksenObj, {ss, "Color"})
                    elseif x:IsA("TextLabel") then
                        x.TextColor3 = T.muted
                        x.Font = FONT
                    end
                end
            end)
        end
    end
end

