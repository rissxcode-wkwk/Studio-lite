-- MainBar Plus + ColorPalette Remake (tema Roblox Studio) + Intro Loading
-- Catatan: Roblox tidak bisa render SVG, jadi ikon memakai glyph/emoji

-- ========================================================================
-- BAGIAN 0: INTRO LOADING (logo tengah + lingkaran muter + tombol Skip)
-- ========================================================================
task.spawn(function()
    -- ISI DI SINI: upload logo ke Roblox, lalu tempel ID-nya. Contoh: "rbxassetid://1234567890"
    local LOGO_ID = "rbxassetid://91557427976489"
    local DURASI = 8 -- detik sebelum intro tutup otomatis

    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local RunService = game:GetService("RunService")

    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")

    local lama = playerGui:FindFirstChild("StudioPlusIntro")
    if lama then lama:Destroy() end

    local BIRU = Color3.fromRGB(0, 162, 255)
    local CYAN = Color3.fromRGB(0, 230, 255)

    local gui = Instance.new("ScreenGui")
    gui.Name = "StudioPlusIntro"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 10000
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = playerGui

    local bg = Instance.new("TextButton")
    bg.Name = "Background"
    bg.AutoButtonColor = false
    bg.Text = ""
    bg.Size = UDim2.fromScale(1, 1)
    bg.BackgroundColor3 = Color3.new(0, 0, 0)
    bg.BorderSizePixel = 0
    bg.ZIndex = 1
    bg.Parent = gui

    -- Lingkaran muter
    local ring = Instance.new("Frame")
    ring.Name = "Ring"
    ring.AnchorPoint = Vector2.new(0.5, 0.5)
    ring.Position = UDim2.fromScale(0.5, 0.5)
    ring.Size = UDim2.fromOffset(210, 210)
    ring.BackgroundTransparency = 1
    ring.ZIndex = 2
    ring.Parent = bg
    local rc = Instance.new("UICorner")
    rc.CornerRadius = UDim.new(1, 0)
    rc.Parent = ring

    local ringStroke = Instance.new("UIStroke")
    ringStroke.Thickness = 5
    ringStroke.Color = Color3.new(1, 1, 1)
    ringStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    ringStroke.Parent = ring

    local ringGrad = Instance.new("UIGradient")
    ringGrad.Color = ColorSequence.new(CYAN, BIRU)
    ringGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.55, 0.15),
        NumberSequenceKeypoint.new(0.56, 1),
        NumberSequenceKeypoint.new(1, 1),
    })
    ringGrad.Parent = ringStroke

    -- Logo tengah
    local logo
    if LOGO_ID ~= "" then
        logo = Instance.new("ImageLabel")
        logo.Image = LOGO_ID
        logo.ScaleType = Enum.ScaleType.Fit
        logo.ImageTransparency = 1
    else
        logo = Instance.new("TextLabel")
        logo.Text = "X"
        logo.Font = Enum.Font.Antique
        logo.TextScaled = true
        logo.TextColor3 = Color3.new(1, 1, 1)
        logo.TextTransparency = 1
        local lg = Instance.new("UIGradient")
        lg.Color = ColorSequence.new(CYAN, BIRU)
        lg.Rotation = 45
        lg.Parent = logo
    end
    logo.Name = "Logo"
    logo.AnchorPoint = Vector2.new(0.5, 0.5)
    logo.Position = UDim2.fromScale(0.5, 0.5)
    logo.Size = UDim2.fromOffset(120, 120)
    logo.BackgroundTransparency = 1
    logo.ZIndex = 3
    logo.Parent = bg

    -- Teks loading
    local lbl = Instance.new("TextLabel")
    lbl.Name = "LoadingText"
    lbl.AnchorPoint = Vector2.new(0.5, 0)
    lbl.Position = UDim2.new(0.5, 0, 0.5, 125)
    lbl.Size = UDim2.fromOffset(200, 20)
    lbl.BackgroundTransparency = 1
    lbl.Text = "Loading..."
    lbl.Font = Enum.Font.SourceSans
    lbl.TextSize = 16
    lbl.TextColor3 = Color3.fromRGB(150, 150, 150)
    lbl.TextTransparency = 1
    lbl.ZIndex = 3
    lbl.Parent = bg

    -- Tombol Skip (pojok kanan bawah)
    local skip = Instance.new("TextButton")
    skip.Name = "Skip"
    skip.AnchorPoint = Vector2.new(1, 1)
    skip.Position = UDim2.new(1, -16, 1, -16)
    skip.Size = UDim2.fromOffset(88, 34)
    skip.AutoButtonColor = false
    skip.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    skip.BorderSizePixel = 0
    skip.Text = "Skip  ›"
    skip.Font = Enum.Font.SourceSans
    skip.TextSize = 18
    skip.TextColor3 = Color3.fromRGB(204, 204, 204)
    skip.ZIndex = 5
    skip.Parent = bg
    local sc = Instance.new("UICorner")
    sc.CornerRadius = UDim.new(0, 3)
    sc.Parent = skip
    local ss = Instance.new("UIStroke")
    ss.Thickness = 1
    ss.Color = Color3.fromRGB(34, 34, 34)
    ss.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    ss.Parent = skip

    skip.MouseEnter:Connect(function()
        TweenService:Create(skip, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(75, 75, 75)}):Play()
        ss.Color = BIRU
    end)
    skip.MouseLeave:Connect(function()
        TweenService:Create(skip, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(60, 60, 60)}):Play()
        ss.Color = Color3.fromRGB(34, 34, 34)
    end)

    -- Fade in
    local imgProp = (logo:IsA("ImageLabel")) and "ImageTransparency" or "TextTransparency"
    TweenService:Create(logo, TweenInfo.new(0.6), {[imgProp] = 0}):Play()
    TweenService:Create(lbl, TweenInfo.new(0.6), {TextTransparency = 0}):Play()

    -- Animasi putar
    local rot = 0
    local conn = RunService.Heartbeat:Connect(function(dt)
        rot = (rot + dt * 360) % 360
        ringGrad.Rotation = rot
    end)

    local selesai = false
    local function tutup()
        if selesai then return end
        selesai = true
        local info = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(bg, info, {BackgroundTransparency = 1}):Play()
        TweenService:Create(logo, info, {[imgProp] = 1}):Play()
        TweenService:Create(lbl, info, {TextTransparency = 1}):Play()
        TweenService:Create(ringStroke, info, {Transparency = 1}):Play()
        TweenService:Create(skip, info, {BackgroundTransparency = 1, TextTransparency = 1}):Play()
        TweenService:Create(ss, info, {Transparency = 1}):Play()
        task.delay(0.55, function()
            if conn then conn:Disconnect() end
            if gui then gui:Destroy() end
        end)
    end

    skip.MouseButton1Click:Connect(tutup)

    -- animasi titik "Loading..."
    task.spawn(function()
        local n = 0
        while not selesai and gui.Parent do
            n = n % 3 + 1
            lbl.Text = "Loading" .. string.rep(".", n)
            task.wait(0.4)
        end
    end)

    task.delay(DURASI, tutup)
end)

-- ========================================================================
-- BAGIAN 1: MAINBAR PLUS (hanya Rig)
-- ========================================================================
task.spawn(function()
    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local Workspace = game:GetService("Workspace")

    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")

    -- ========== BERSIHKAN VERSI LAMA ==========
    local genv = (getgenv and getgenv()) or _G
    if genv.StudioPlusBersih then
        pcall(genv.StudioPlusBersih)
    end
    local uiLama = playerGui:FindFirstChild("StudioPlusUI")
    if uiLama then uiLama:Destroy() end

    local aktif = true
    local koneksi = {}
    local koneksiBar = {}

    local function sambung(sinyal, fn)
        if not sinyal then return nil end
        local c = sinyal:Connect(fn)
        table.insert(koneksi, c)
        return c
    end

    local function sambungBar(sinyal, fn)
        if not sinyal then return nil end
        local c = sinyal:Connect(fn)
        table.insert(koneksiBar, c)
        return c
    end

    local function putusBar()
        for _, c in ipairs(koneksiBar) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(koneksiBar)
    end

    -- ========== TEMA ROBLOX STUDIO (DARK) ==========
    local T = {
        bg = Color3.fromRGB(46, 46, 46),
        panel = Color3.fromRGB(37, 37, 37),
        btn = Color3.fromRGB(60, 60, 60),
        hover = Color3.fromRGB(75, 75, 75),
        border = Color3.fromRGB(34, 34, 34),
        text = Color3.fromRGB(204, 204, 204),
        muted = Color3.fromRGB(150, 150, 150),
        aksen = Color3.fromRGB(0, 162, 255),
        selected = Color3.fromRGB(0, 90, 140),
        pending = Color3.fromRGB(255, 170, 0),
        pendingBg = Color3.fromRGB(95, 70, 20),
    }

    local FONT = Enum.Font.SourceSans
    local FONT_B = Enum.Font.SourceSansSemibold

    -- ========== HELPER ==========
    local function buat(kelas, props, induk)
        local o = Instance.new(kelas)
        for k, v in pairs(props or {}) do
            o[k] = v
        end
        if induk then o.Parent = induk end
        return o
    end

    local function garis(obj, tebal, warna)
        local s = obj:FindFirstChildOfClass("UIStroke")
        if not s then
            s = Instance.new("UIStroke")
            s.Parent = obj
        end
        s.Thickness = tebal
        s.Color = warna
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        return s
    end

    local function sudut(obj, r)
        local c = obj:FindFirstChildOfClass("UICorner")
        if not c then
            c = Instance.new("UICorner")
            c.Parent = obj
        end
        c.CornerRadius = UDim.new(0, r)
        return c
    end

    local function tween(obj, props, waktu)
        if not obj or not obj.Parent then return end
        pcall(function()
            TweenService:Create(obj, TweenInfo.new(waktu or 0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
        end)
    end

    -- ========== CARI MAINBAR ==========
    local function cariMainBar()
        local g = playerGui:FindFirstChild("StudioGui")
        local m = g and g:FindFirstChild("MainBar")
        if m then return m end
        for _, d in ipairs(playerGui:GetDescendants()) do
            if d.Name == "MainBar" and d:IsA("GuiObject") then
                return d
            end
        end
        return nil
    end

    -- ========== NOTIFIKASI (TOAST) ==========
    local ui = buat("ScreenGui", {
        Name = "StudioPlusUI",
        ResetOnSpawn = false,
        DisplayOrder = 999,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, playerGui)

    local toast = buat("TextLabel", {
        Size = UDim2.new(0, 260, 0, 28),
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, 12),
        BackgroundColor3 = T.bg,
        BackgroundTransparency = 1,
        TextTransparency = 1,
        Text = "",
        TextColor3 = T.text,
        Font = FONT,
        TextSize = 16,
        ZIndex = 50,
    }, ui)
    sudut(toast, 3)
    local toastStroke = garis(toast, 1, T.border)
    toastStroke.Transparency = 1
    local toastId = 0
    local function notif(teks)
        toastId += 1
        local id = toastId
        toast.Text = teks
        tween(toast, {BackgroundTransparency = 0, TextTransparency = 0}, 0.15)
        tween(toastStroke, {Transparency = 0}, 0.15)
        task.delay(2, function()
            if id == toastId and toast.Parent then
                tween(toast, {BackgroundTransparency = 1, TextTransparency = 1}, 0.25)
                tween(toastStroke, {Transparency = 1}, 0.25)
            end
        end)
    end

    -- ========== STATE ==========
    local R6 = Enum.HumanoidRigType.R6
    local R15 = Enum.HumanoidRigType.R15

    local function ambilKarakter()
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        return char, hum, hrp
    end

    -- hapus dummy char diri sendiri (model bernama sama dengan player, selain karakter aktif)
    local function hapusDummyDiri()
        for _, m in ipairs(Workspace:GetChildren()) do
            if m:IsA("Model")
                and m.Name == player.Name
                and m ~= player.Character
                and m:FindFirstChildOfClass("Humanoid") then
                pcall(function() m:Destroy() end)
            end
        end
    end

    local rigPilihan = R15
    do
        local _, hum = ambilKarakter()
        if hum then rigPilihan = hum.RigType end
    end
    local sedangGanti = false
    local izinPlay = false

    local tombolRig = nil
    local tombolPlay = nil

    -- ========== STATE MAINBAR ==========
    local mainBar = nil
    local ukuranAsliBar = nil
    local absAsli = Vector2.new(0, 0)
    local tombolBaru = {}
    local sumbuX, pAcuan, sAcuan = true, Vector2.new(0, 0), Vector2.new(40, 40)
    local kursor = 0
    local JARAK = 4

    -- ========== MAKEOVER TOMBOL BAWAAN (STYLE STUDIO) ==========
    local function gayaTombolAsli(b)
        if not (b:IsA("TextButton") or b:IsA("ImageButton")) then return end
        pcall(function()
            b.AutoButtonColor = false
            b.BackgroundColor3 = T.btn
            b.BackgroundTransparency = 0
            b.BorderSizePixel = 0
            if b:IsA("TextButton") then
                b.TextColor3 = T.text
                b.Font = FONT
            end
            sudut(b, 3)
            local s = garis(b, 1, T.border)
            sambungBar(b.MouseEnter, function()
                tween(b, {BackgroundColor3 = T.hover})
                s.Color = T.aksen
            end)
            sambungBar(b.MouseLeave, function()
                tween(b, {BackgroundColor3 = T.btn})
                s.Color = T.border
            end)
        end)
    end

    local function makeoverMainBar()
        pcall(function()
            mainBar.BackgroundColor3 = T.bg
            mainBar.BackgroundTransparency = 0
            mainBar.BorderSizePixel = 0
            mainBar.ClipsDescendants = false
            sudut(mainBar, 4)
            garis(mainBar, 1, T.border)
        end)

        for _, anak in ipairs(mainBar:GetChildren()) do
            if string.sub(anak.Name, 1, 3) ~= "SP_" then
                if anak:IsA("TextButton") or anak:IsA("ImageButton") then
                    gayaTombolAsli(anak)
                elseif anak.Name == "sel" then
                    for _, t in ipairs(anak:GetChildren()) do
                        gayaTombolAsli(t)
                    end
                elseif anak.Name == "Snap" then
                    pcall(function()
                        anak.BackgroundColor3 = T.panel
                        anak.BackgroundTransparency = 0
                        anak.BorderSizePixel = 0
                        sudut(anak, 3)
                        garis(anak, 1, T.border)
                        for _, x in ipairs(anak:GetChildren()) do
                            if x:IsA("TextBox") then
                                x.BackgroundColor3 = T.panel
                                x.BorderSizePixel = 0
                                x.TextColor3 = T.text
                                x.PlaceholderColor3 = T.muted
                                x.Font = FONT
                                sudut(x, 3)
                                garis(x, 1, T.border)
                            elseif x:IsA("TextLabel") then
                                x.TextColor3 = T.muted
                                x.Font = FONT
                            end
                        end
                    end)
                end
            end
        end
    end

    -- ========== PEMBUAT TOMBOL ==========
    local function buatTombol(judul, ikon, nilaiAwal, klik)
        local pos = sumbuX and Vector2.new(kursor, pAcuan.Y) or Vector2.new(pAcuan.X, kursor)
        kursor = kursor + (sumbuX and sAcuan.X or sAcuan.Y) + JARAK

        local b = buat("TextButton", {
            Name = "SP_" .. judul,
            Size = UDim2.fromOffset(sAcuan.X, sAcuan.Y),
            Position = UDim2.fromOffset(pos.X, pos.Y),
            AnchorPoint = Vector2.new(0, 0),
            BackgroundColor3 = T.btn,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "",
            ClipsDescendants = true,
            Visible = true,
            ZIndex = 10,
        }, mainBar)
        sudut(b, 3)
        local s = garis(b, 1, T.border)

        local lblIkon = buat("TextLabel", {
            Name = "Ikon",
            Size = UDim2.new(1, 0, 0.58, 0),
            Position = UDim2.new(0, 0, 0.04, 0),
            BackgroundTransparency = 1,
            Text = ikon,
            TextColor3 = T.text,
            Font = Enum.Font.SourceSansBold,
            TextScaled = true,
            ZIndex = 11,
        }, b)
        buat("UITextSizeConstraint", {MaxTextSize = 24, MinTextSize = 10}, lblIkon)

        local lblNilai = buat("TextLabel", {
            Name = "Nilai",
            Size = UDim2.new(1, -4, 0.30, 0),
            Position = UDim2.new(0, 2, 0.62, 0),
            BackgroundTransparency = 1,
            Text = nilaiAwal,
            TextColor3 = T.muted,
            Font = FONT,
            TextScaled = true,
            ZIndex = 11,
        }, b)
        buat("UITextSizeConstraint", {MaxTextSize = 14, MinTextSize = 7}, lblNilai)

        local indikator = buat("Frame", {
            Name = "Indikator",
            Size = UDim2.new(0.7, 0, 0, 2),
            AnchorPoint = Vector2.new(0.5, 1),
            Position = UDim2.new(0.5, 0, 1, -2),
            BackgroundColor3 = T.aksen,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 11,
        }, b)

        local warnaDasar = T.btn
        sambungBar(b.MouseEnter, function()
            s.Color = T.aksen
            tween(b, {BackgroundColor3 = T.hover}, 0.08)
        end)
        sambungBar(b.MouseLeave, function()
            s.Color = T.border
            tween(b, {BackgroundColor3 = warnaDasar}, 0.08)
        end)
        sambungBar(b.MouseButton1Click, function()
            pcall(klik)
        end)

        local obj = {}
        function obj.set(nilai, status)
            if not b.Parent then return end
            lblNilai.Text = nilai
            if status == "aktif" then
                warnaDasar = T.selected
                tween(indikator, {BackgroundTransparency = 0, BackgroundColor3 = T.aksen})
                lblNilai.TextColor3 = Color3.new(1, 1, 1)
                lblIkon.TextColor3 = Color3.new(1, 1, 1)
            elseif status == "menunggu" then
                warnaDasar = T.pendingBg
                tween(indikator, {BackgroundTransparency = 0, BackgroundColor3 = T.pending})
                lblNilai.TextColor3 = Color3.new(1, 1, 1)
                lblIkon.TextColor3 = T.pending
            else
                warnaDasar = T.btn
                tween(indikator, {BackgroundTransparency = 1})
                lblNilai.TextColor3 = T.muted
                lblIkon.TextColor3 = T.text
            end
            tween(b, {BackgroundColor3 = warnaDasar})
        end
        table.insert(tombolBaru, b)
        return obj
    end

    -- ========== FITUR: RIG ==========
    local function perbaruiTombolRig()
        if not tombolRig then return end
        local _, hum = ambilKarakter()
        local namaPilih = (rigPilihan == R6) and "R6" or "R15"
        local sekarang = hum and ((hum.RigType == R6) and "R6" or "R15") or nil
        if sekarang and sekarang ~= namaPilih then
            tombolRig.set("▶ " .. namaPilih, "menunggu")
        else
            tombolRig.set(namaPilih, "aktif")
        end
    end

    local function terapkanRig(char)
        if not char or not char.Parent then return end
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
        if not hum then return end
        if hum.RigType == rigPilihan or sedangGanti then
            perbaruiTombolRig()
            return
        end
        sedangGanti = true
        task.spawn(function()
            local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
            local cf = hrp and hrp.CFrame or CFrame.new(0, 10, 0)
            local ok, err = pcall(function()
                local desc = Players:GetHumanoidDescriptionFromUserId(player.UserId)
                local model = Players:CreateHumanoidModelFromDescription(desc, rigPilihan)
                model.Name = player.Name
                player.Character = model
                model.Parent = Workspace
                model:PivotTo(cf)
                if char and char.Parent then char:Destroy() end
                local hBaru = model:WaitForChild("Humanoid", 5)
                local cam = Workspace.CurrentCamera
                if hBaru and cam then cam.CameraSubject = hBaru end
            end)
            if ok then
                notif("Rig diganti ke " .. ((rigPilihan == R6) and "R6" or "R15"))
            else
                warn("[StudioPlus] Gagal ganti rig:", err)
                notif("Gagal ganti rig")
            end
            sedangGanti = false
            task.wait(0.3)
            hapusDummyDiri()
            perbaruiTombolRig()
        end)
    end

    local function saatPlayDitekan()
        local _, hum = ambilKarakter()
        local sekarang = hum and hum.RigType or nil
        if sekarang and sekarang == rigPilihan then return end

        izinPlay = true
        task.delay(1.5, function()
            if izinPlay and aktif then
                izinPlay = false
                local char = player.Character
                if char then terapkanRig(char) end
            end
        end)
    end

    local function cariTombolPlay()
        local p = mainBar:FindFirstChild("play", true)
        if p and p:IsA("GuiButton") then return p end
        for _, d in ipairs(mainBar:GetDescendants()) do
            if d:IsA("GuiButton") and string.lower(d.Name) == "play" then
                return d
            end
        end
        return nil
    end

    -- ========== BANGUN TOMBOL RIG DI MAINBAR ==========
    local function bangunTombol()
        if not mainBar or not mainBar.Parent then return end

        for _, b in ipairs(tombolBaru) do
            pcall(function() b:Destroy() end)
        end
        table.clear(tombolBaru)
        if ukuranAsliBar then
            pcall(function() mainBar.Size = ukuranAsliBar end)
        end
        task.wait()

        local daftarAsli = {}
        for _, n in ipairs({"select", "move", "scale", "rotate", "play", "toolbox", "partsel", "Snap"}) do
            local c = mainBar:FindFirstChild(n)
            if c and c:IsA("GuiObject") then
                table.insert(daftarAsli, c)
            end
        end
        if #daftarAsli == 0 then
            for _, c in ipairs(mainBar:GetChildren()) do
                if c:IsA("GuiObject") and string.sub(c.Name, 1, 3) ~= "SP_" then
                    table.insert(daftarAsli, c)
                end
            end
        end
        if #daftarAsli == 0 then
            warn("[StudioPlus] Tidak ada tombol di MainBar sebagai acuan.")
            return
        end

        local function posLokal(c)
            if mainBar.Rotation == 0 then
                return c.AbsolutePosition - mainBar.AbsolutePosition
            end
            local ps = mainBar.AbsoluteSize
            return Vector2.new(
                c.Position.X.Scale * ps.X + c.Position.X.Offset - c.AnchorPoint.X * c.AbsoluteSize.X,
                c.Position.Y.Scale * ps.Y + c.Position.Y.Offset - c.AnchorPoint.Y * c.AbsoluteSize.Y
            )
        end

        local minX, maxX, minY, maxY = math.huge, -math.huge, math.huge, -math.huge
        for _, c in ipairs(daftarAsli) do
            local p = posLokal(c)
            minX, maxX = math.min(minX, p.X), math.max(maxX, p.X)
            minY, maxY = math.min(minY, p.Y), math.max(maxY, p.Y)
        end

        sumbuX = (maxX - minX) >= (maxY - minY)

        local ujung = 0
        for _, c in ipairs(daftarAsli) do
            local p = posLokal(c)
            local akhir = sumbuX and (p.X + c.AbsoluteSize.X) or (p.Y + c.AbsoluteSize.Y)
            ujung = math.max(ujung, akhir)
        end

        local acuan = mainBar:FindFirstChild("select") or daftarAsli[1]
        pAcuan = posLokal(acuan)
        sAcuan = acuan.AbsoluteSize
        if sAcuan.X <= 0 or sAcuan.Y <= 0 then
            sAcuan = Vector2.new(40, 40)
        end
        kursor = ujung + JARAK

        -- ---- Rig ----
        tombolRig = buatTombol("Rig", "☺", (rigPilihan == R6) and "R6" or "R15", function()
            rigPilihan = (rigPilihan == R6) and R15 or R6
            perbaruiTombolRig()
            if tombolPlay then
                notif("Rig dipilih: " .. ((rigPilihan == R6) and "R6" or "R15") .. " - tekan Play untuk menerapkan")
            else
                terapkanRig(player.Character)
            end
        end)

        -- perpanjang MainBar jika tombol melebihi ukuran asli
        local saatIni = sumbuX and absAsli.X or absAsli.Y
        if kursor > saatIni then
            local tambah = kursor - saatIni + JARAK
            local S = ukuranAsliBar or mainBar.Size
            if sumbuX then
                mainBar.Size = UDim2.new(S.X.Scale, S.X.Offset + tambah, S.Y.Scale, S.Y.Offset)
            else
                mainBar.Size = UDim2.new(S.X.Scale, S.X.Offset, S.Y.Scale, S.Y.Offset + tambah)
            end
        end

        perbaruiTombolRig()
    end

    -- ========== PASANG KE MAINBAR ==========
    local function pasang(bar)
        putusBar()
        mainBar = bar
        ukuranAsliBar = bar.Size
        absAsli = bar.AbsoluteSize
        table.clear(tombolBaru)

        pcall(function()
            local sg = bar:FindFirstAncestorOfClass("ScreenGui")
            if sg then sg.ResetOnSpawn = false end
        end)

        makeoverMainBar()

        tombolPlay = cariTombolPlay()
        if tombolPlay then
            sambungBar(tombolPlay.MouseButton1Click, saatPlayDitekan)
            sambungBar(tombolPlay.Activated, saatPlayDitekan)
        else
            warn("[StudioPlus] Tombol 'play' tidak ditemukan, rig diterapkan langsung saat tombol Rig ditekan.")
        end

        bangunTombol()
    end

    -- ========== TUNGGU MAINBAR LALU PASANG ==========
    do
        local bar = cariMainBar()
        local t0 = os.clock()
        while not bar and os.clock() - t0 < 15 do
            task.wait(0.25)
            bar = cariMainBar()
        end
        if not bar then
            warn("[StudioPlus] MainBar tidak ditemukan di PlayerGui.")
            ui:Destroy()
            return
        end
        task.wait(0.2)
        pasang(bar)
    end

    -- ========== PENJAGA: PASANG ULANG JIKA TOMBOL HILANG ==========
    task.spawn(function()
        while aktif do
            task.wait(0.4)
            if not aktif then break end

            local bar = cariMainBar()
            if bar and bar ~= mainBar then
                task.wait(0.25)
                if aktif then pasang(bar) end
            elseif mainBar and mainBar.Parent then
                local perlu = (#tombolBaru < 1)
                if not perlu then
                    for _, b in ipairs(tombolBaru) do
                        if (not b) or b.Parent ~= mainBar then
                            perlu = true
                            break
                        end
                        if not b.Visible then b.Visible = true end
                    end
                end
                if perlu then
                    bangunTombol()
                end
            end
        end
    end)

    -- ========== SAAT KARAKTER SPAWN ==========
    sambung(player.CharacterAdded, function(char)
        if izinPlay and not sedangGanti then
            izinPlay = false
            task.wait(0.2)
            terapkanRig(char)
        else
            task.wait(0.4)
            hapusDummyDiri()
            perbaruiTombolRig()
        end
    end)

    -- ========== PEMBERSIH ==========
    genv.StudioPlusBersih = function()
        aktif = false
        izinPlay = false
        for _, c in ipairs(koneksi) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(koneksi)
        putusBar()
        for _, b in ipairs(tombolBaru) do
            pcall(function() b:Destroy() end)
        end
        table.clear(tombolBaru)
        pcall(function()
            if mainBar and ukuranAsliBar then mainBar.Size = ukuranAsliBar end
        end)
        pcall(function() if ui then ui:Destroy() end end)
    end

    notif("MainBar Plus aktif")
end)

