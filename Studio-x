local function makeButton(parent, text, layoutOrder)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BackgroundColor3 = THEME.btn
	b.BorderSizePixel = 0
	b.Font = Enum.Font.SourceSans
	b.TextSize = 16
	b.TextColor3 = THEME.text
	b.Text = text
	b.LayoutOrder = layoutOrder or 0
	b.Parent = parent
	addCorner(b, 3)
	local st = addStroke(b, THEME.border, 1, 0)
	b.MouseEnter:Connect(function()
		tween(b, TWEEN_FAST, { BackgroundColor3 = THEME.btnHover }, b)
		tween(st, TWEEN_FAST, { Color = THEME.accent }, st)
	end)
	b.MouseLeave:Connect(function()
		tween(b, TWEEN_FAST, { BackgroundColor3 = THEME.btn }, b)
		tween(st, TWEEN_FAST, { Color = THEME.border }, st)
	end)
	return b
end

local function makeBox(parent, text, placeholder)
	local t = Instance.new("TextBox")
	t.BackgroundColor3 = THEME.input
	t.BorderSizePixel = 0
	t.Font = Enum.Font.SourceSans
	t.TextSize = 16
	t.TextColor3 = THEME.text
	t.PlaceholderColor3 = THEME.textDim
	t.PlaceholderText = placeholder or ""
	t.Text = text or ""
	t.ClearTextOnFocus = false
	t.Parent = parent
	addCorner(t, 3)
	local st = addStroke(t, THEME.border2, 1, 0)
	t.Focused:Connect(function()
		tween(st, TWEEN_FAST, { Color = THEME.accent }, st)
	end)
	t.FocusLost:Connect(function()
		tween(st, TWEEN_FAST, { Color = THEME.border2 }, st)
	end)
	return t, st
end

local function gridRow(height, cols)
	local f = row(height)
	local g = Instance.new("UIGridLayout")
	g.CellPadding = UDim2.fromOffset(4, 0)
	g.CellSize = UDim2.new(1 / cols, -4, 1, 0)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = f
	return f
end

local function buttonRow(labels)
	local f = gridRow(26, #labels)
	local out = {}
	for i, l in ipairs(labels) do
		out[i] = makeButton(f, l, i)
	end
	return out
end

local function swatchRow(count, perRow, height)
	local rows = math.ceil(count / perRow)
	local f = row(rows * height + (rows - 1) * 4)
	local g = Instance.new("UIGridLayout")
	g.CellPadding = UDim2.fromOffset(4, 4)
	g.CellSize = UDim2.new(1 / perRow, -4, 0, height)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = f
	local list = {}
	for i = 1, count do
		local s = Instance.new("TextButton")
		s.Text = ""
		s.AutoButtonColor = false
		s.LayoutOrder = i
		s.BackgroundColor3 = THEME.input
		s.BorderSizePixel = 0
		s.Parent = f
		addCorner(s, 3)
		local st = addStroke(s, THEME.border2, 1, 0)
		s.MouseEnter:Connect(function()
			tween(st, TWEEN_FAST, { Color = THEME.accent, Thickness = 2 }, st)
		end)
		s.MouseLeave:Connect(function()
			tween(st, TWEEN_FAST, { Color = THEME.border2, Thickness = 1 }, st)
		end)
		list[i] = s
	end
	return list
end

