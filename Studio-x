---------------------------------------------------------------------
-- Palette gradient (hue X, saturasi Y) + gelap sesuai Darkness
-- ZIndex dibuat relatif ke palette supaya gradient tidak tertutup
---------------------------------------------------------------------
local darkOverlay, darkGradient
local paletteZ = 1

if palette and palette:IsA("GuiObject") then
	paletteZ = palette.ZIndex
	palette.BackgroundTransparency = 1
	palette.ClipsDescendants = true
	if palette:IsA("ImageButton") or palette:IsA("ImageLabel") then
		palette.ImageTransparency = 1
	end

	-- hapus layer lama kalau script jalan ulang
	for _, n in ipairs({ "HueLayer", "SatLayer", "DarkLayer" }) do
		local old = palette:FindFirstChild(n)
		if old then old:Destroy() end
	end

	local function layer(name, z)
		local f = Instance.new("Frame")
		f.Name = name
		f.AnchorPoint = Vector2.new(0, 0)
		f.Position = UDim2.fromScale(0, 0)
		f.Size = UDim2.fromScale(1, 1)
		f.BorderSizePixel = 0
		f.Active = false
		f.Visible = true
		f.ZIndex = paletteZ + z
		f.BackgroundTransparency = 0
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		f.Parent = palette
		return f
	end

	-- Layer 1: pelangi horizontal
	local base = layer("HueLayer", 1)
	local hg = Instance.new("UIGradient")
	local keys = {}
	for i = 0, 6 do
		keys[#keys + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i == 6 and 0 or i / 6, 1, 1))
	end
	hg.Color = ColorSequence.new(keys)
	hg.Rotation = 0
	hg.Parent = base

	-- Layer 2: putih (atas = pekat -> bawah = hilang) => saturasi
	-- Atas saturasi 0 (putih), bawah saturasi 1 (warna penuh)
	local satLayer = layer("SatLayer", 2)
	satLayer.BackgroundColor3 = Color3.new(1, 1, 1)
	local sg = Instance.new("UIGradient")
	sg.Rotation = 90
	sg.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0),
	})
	sg.Parent = satLayer

	-- Layer 3: hitam, transparansi diatur lewat Darkness
	darkOverlay = layer("DarkLayer", 3)
	darkOverlay.BackgroundColor3 = Color3.new(0, 0, 0)
	darkOverlay.BackgroundTransparency = 1 - (1 - val)

	-- Palette mengikuti urutan: atas = saturasi tinggi.
	-- Dibalik supaya cocok dengan rumus sat = 1 - ry
	sg.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
end

