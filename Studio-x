local function insideGui(gui, pos)
	local p, s = gui.AbsolutePosition, gui.AbsoluteSize
	return pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
end

local pressOutside = false
local pressTime = 0

UserInputService.InputBegan:Connect(function(input)
	if not isPress(input) then return end
	pressOutside = false
	if not colorPalette.Visible or closing then return end
	local pos = input.Position
	if insideGui(colorPalette, pos) or insideGui(extras, pos) then return end
	pressOutside = true
	pressTime = os.clock()
end)

UserInputService.InputEnded:Connect(function(input)
	if not isPress(input) or not pressOutside then return end
	pressOutside = false
	if not colorPalette.Visible or closing then return end
	if openedAt > pressTime then return end -- frame baru dibuka setelah klik ini (toggle)
	cancel(true)
end)

---------------------------------------------------------------------
-- Shortcut keyboard
-- Enter OK | Esc batal | R random | F favorit | I invert
-- Ctrl+Z undo | Ctrl+Y / Ctrl+Shift+Z redo
-- Panah hue/sat | PageUp/PageDown terang/gelap | Shift = cepat
---------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe or not colorPalette.Visible or closing then return end
	local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
	local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
	local step = shift and 0.05 or 0.01
	local k = input.KeyCode

	if ctrl and k == Enum.KeyCode.Z then
		if shift then redo() else undo() end
		return
	elseif ctrl and k == Enum.KeyCode.Y then
		redo()
		return
	end

	if k == Enum.KeyCode.Return or k == Enum.KeyCode.KeypadEnter then
		confirm()
	elseif k == Enum.KeyCode.Escape then
		cancel(false)
	elseif k == Enum.KeyCode.R then
		randomColor()
	elseif k == Enum.KeyCode.F then
		addFavorite(currentColor)
	elseif k == Enum.KeyCode.I then
		changeColor(Color3.new(1 - currentColor.R, 1 - currentColor.G, 1 - currentColor.B), true)
	elseif k == Enum.KeyCode.Left then
		snapshot(true); hue = (hue - step) % 1
		updateColor(); updateIndicators(true)
	elseif k == Enum.KeyCode.Right then
		snapshot(true); hue = (hue + step) % 1
		updateColor(); updateIndicators(true)
	elseif k == Enum.KeyCode.Up then
		snapshot(true); sat = math.clamp(sat + step, 0, 1)
		updateColor(); updateIndicators(true)
	elseif k == Enum.KeyCode.Down then
		snapshot(true); sat = math.clamp(sat - step, 0, 1)
		updateColor(); updateIndicators(true)
	elseif k == Enum.KeyCode.PageUp then
		snapshot(true); val = math.clamp(val + step, 0, 1)
		updateColor(); updateIndicators(true)
	elseif k == Enum.KeyCode.PageDown then
		snapshot(true); val = math.clamp(val - step, 0, 1)
		updateColor(); updateIndicators(true)
	end
end)

