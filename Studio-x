-- ========== HELPER UI ==========
local FONT = Enum.Font.SourceSans
local FONT_B = Enum.Font.SourceSansSemibold

local function buat(kelas, props, induk)
    local o = Instance.new(kelas)
    for k, v in pairs(props or {}) do
        o[k] = v
    end
    if induk then o.Parent = induk end
    return o
end

local function sudut(obj, r)
    return buat("UICorner", {CornerRadius = UDim.new(0, r or 4)}, obj)
end

local function garis(obj, tebal, warna, transp)
    local s = obj:FindFirstChildOfClass("UIStroke")
    if not s then s = Instance.new("UIStroke") s.Parent = obj end
    s.Thickness = tebal or 1
    s.Color = warna or T.border
    s.Transparency = transp or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    return s
end

local function tween(obj, props, waktu)
    local t = TweenService:Create(obj, TweenInfo.new(waktu or 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

