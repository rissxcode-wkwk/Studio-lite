    ---------------------------------------------------------------------
    -- Input palette / darkness
    ---------------------------------------------------------------------
    local function pulseCrosshair()
        if not crosshair or not crosshair:IsA("GuiObject") then return end
        local base = crosshair:GetAttribute("BaseSize")
        if not base then
            base = crosshair.Size
            crosshair:SetAttribute("BaseSize", base)
        end
        crosshair.Size = UDim2.new(base.X.Scale, base.X.Offset + 8, base.Y.Scale, base.Y.Offset + 8)
        tween(crosshair, TWEEN_POP, { Size = base }, "crosshairPulse")
    end

    local function handlePalette(pos)
        if not palette or not palette:IsA("GuiObject") then return end
        if palette.AbsoluteSize.X <= 0 or palette.AbsoluteSize.Y <= 0 then return end
        local rx = math.clamp((pos.X - palette.AbsolutePosition.X) / palette.AbsoluteSize.X, 0, 1)
        local ry = math.clamp((pos.Y - palette.AbsolutePosition.Y) / palette.AbsoluteSize.Y, 0, 1)
        hue = rx
        sat = 1 - ry
        updateColor()
        updateIndicators(true)
    end

    local function handleDarkness(pos)
        if not darkness or not darkness:IsA("GuiObject") then return end
        if darkness.AbsoluteSize.Y <= 0 then return end
        local ry = math.clamp((pos.Y - darkness.AbsolutePosition.Y) / darkness.AbsoluteSize.Y, 0, 1)
        val = 1 - ry
        updateColor()
        updateIndicators(true)
    end

    local function isPress(input)
        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
    end

    if palette and palette:IsA("GuiObject") then
        palette.InputBegan:Connect(function(input)
            if isPress(input) then
                snapshot()
                draggingPalette = true
                pulseCrosshair()
                handlePalette(input.Position)
            end
        end)
        palette.MouseEnter:Connect(function() hoverWheel += 1 end)
        palette.MouseLeave:Connect(function() hoverWheel = math.max(0, hoverWheel - 1) end)
    end

    if darkness and darkness:IsA("GuiObject") then
        darkness.InputBegan:Connect(function(input)
            if isPress(input) then
                snapshot()
                draggingDarkness = true
                handleDarkness(input.Position)
            end
        end)
        darkness.MouseEnter:Connect(function() hoverWheel += 1 end)
        darkness.MouseLeave:Connect(function() hoverWheel = math.max(0, hoverWheel - 1) end)
    end

    handle.InputBegan:Connect(function(input)
        if isPress(input) then
            draggingWindow = true
            dragStart = input.Position
            dragOrigin = colorPalette.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            if hoverWheel > 0 and colorPalette.Visible then
                snapshot(true)
                val = math.clamp(val + input.Position.Z * 0.03, 0, 1)
                updateColor()
                updateIndicators(true)
            end
        elseif input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            if draggingWindow and dragStart and dragOrigin then
                local d = input.Position - dragStart
                colorPalette.Position = UDim2.new(
                    dragOrigin.X.Scale, dragOrigin.X.Offset + d.X,
                    dragOrigin.Y.Scale, dragOrigin.Y.Offset + d.Y
                )
            elseif draggingPalette then
                handlePalette(input.Position)
            elseif draggingDarkness then
                handleDarkness(input.Position)
            end
        end
    end)

