    local function insideGui(gui, pos)
        if not gui then return false end
        local p, s = gui.AbsolutePosition, gui.AbsoluteSize
        return pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
    end

    local cancel -- forward

    UserInputService.InputBegan:Connect(function(input)
        if not isPress(input) then return end
        if not colorPalette.Visible or closing then return end
        if os.clock() - openedAt < 0.3 then return end
        local pos = input.Position
        if insideGui(colorPalette, pos) or insideGui(extras, pos) then return end
        pressedOutside = true
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not isPress(input) then return end

        if draggingWindow then
            tween(grip, TWEEN_FAST, { Size = UDim2.fromOffset(40, 4), BackgroundColor3 = THEME.textDim, BackgroundTransparency = 0.3 }, "gripHover")
        end
        draggingPalette = false
        draggingDarkness = false
        draggingWindow = false

        if pressedOutside then
            pressedOutside = false
            task.delay(0.1, function()
                if colorPalette.Visible and not closing and cancel then
                    cancel(true)
                end
            end)
        end
    end)

